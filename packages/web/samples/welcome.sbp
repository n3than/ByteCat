# Welcome to Bytecat! Press the green flag, then steer the ball with the arrow keys.
# Click the ball to make it talk. Change anything here and press the flag again.
var clicks = 0

stage:
  backdrop sky "#d7ecff"

sprite Spinner:
  costume tri = triangle "#7c4dff"
  position -190, 140

  when flag:
    forever:
      turn_right(4)

sprite Ball:
  costume ball = circle "#ff8c1a"
  position 0, 0
  direction 45

  when flag:
    clicks = 0
    log("Steer with the left and right arrow keys")
    forever:
      move(6)
      bounce()
      if key_pressed("left arrow"):
        turn_left(6)
      if key_pressed("right arrow"):
        turn_right(6)

  when clicked:
    clicks += 1
    say(join("You clicked me ", clicks, " times"), 1)
