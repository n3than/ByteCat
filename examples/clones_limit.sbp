# Bytecat has no clone limit by default; TurboWarp (and `--compat turbowarp`) allows at most 300
# clones at once, counted across all sprites, and deleting one makes room again
# (clones_limit.turbowarp.expected). The stage can clone a sprite by name but not itself, an unknown
# name clones nothing, and a clone can clone itself. `delete_clone()` inside a custom block ends the
# clone's whole script.
var alive = 0
var total = 0

stage:
  when flag:
    create_clone("_myself_")
    create_clone("Nobody")
    create_clone("Dog")
    wait(0)
    log(join("after the stage: ", alive))
    broadcast("spawn")
    wait(0)
    log(join("alive after spawning: ", alive))
    log(join("clones made: ", total))
    broadcast_wait("thin out")
    log(join("alive after thinning: ", alive))
    broadcast("spawn")
    wait(0)
    log(join("alive after refilling: ", alive))
    log(join("clones made: ", total))
    stop("all")

sprite Dog:
  costume c = circle "#0088ff"
  var id = 0

  define warp spawn_many(n):
    repeat n:
      create_clone("_myself_")

  define vanish():
    alive -= 1
    delete_clone()
    log("never: the clone is gone")

  when cloned:
    alive += 1
    total += 1
    id = total
    # A clone of a clone, made while there is room.
    if id == 1:
      create_clone("_myself_")

  when receive "spawn":
    if id == 0:
      spawn_many(400)

  when receive "thin out":
    if id > 0 and id % 2 == 0:
      vanish()
      log("never: the script ended in vanish")
