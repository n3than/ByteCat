# Control flow: if/elif/else, repeat until, nested loops and stop("this script").
var i = 0
var total = 0

sprite Main:
  define classify(n):
    if n < 0:
      log("negative")
    elif n = 0:
      log("zero")
    else:
      log("positive")

  when flag:
    classify(-5)
    classify(0)
    classify(7)
    repeat until total >= 10:
      total += 3
    log(total)
    i = 0
    forever:
      i += 1
      if i = 4:
        log(i)
        stop("this script")
