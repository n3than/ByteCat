# Numeric literals. A literal like 1 or 0.5 is a number when it prints back as the same text
# (TurboWarp's rule), and text otherwise ("1.0", " 1", "-0", "1e3", "0x10", ""). The difference is
# visible in a few places: how "contents of list" joins single digits, which costume a name picks,
# and what a literal looks like after a round trip through a variable or a procedure argument.
var v = 0
var a = 0
list digits
list words

sprite Main:
  costume alpha = circle "#ff0000"
  costume beta = square "#00ff00"
  costume "2" = triangle "#0000ff"

  define report(x):
    log(join("arg ", x))
    log(length(x))
    log(x = 1)
    log(x < 2)

  define pick(n):
    switch_costume(n)

  define twice(x):
    log(x + x)

  when flag:
    # Single digits join without spaces only when every item is text.
    digits.add(5)
    digits.add(6)
    log(digits)
    words.add("5")
    words.add("6")
    log(words)
    digits.add("7")
    log(digits)
    digits.clear()
    digits.add(1 + 2)
    digits.add(2 + 2)
    log(digits)
    digits.clear()
    digits.add(5)
    digits.add(10)
    log(digits)

    # Round trips keep the text of a literal that is not in canonical form.
    v = 1.0
    log(join("v=", v))
    log(length(v))
    v = 1
    log(length(v))
    log(letter(1, 10))
    log(letter(2, 10))
    log(letter(1, 1.5))
    log(letter(1, -3))
    log(length(1e3))
    log(length(1e21))
    log(length(0.5))
    log(length(" 1"))
    log(join(0.5, 1.0))
    log(join("-0", -0))

    # Comparisons.
    log("1.0" = 1)
    log(1.0 = "1")
    log(" 1" < 2)
    log(" 1" = 1)
    log(1 = 1)
    log("1" = 1.0)
    log("abc" < 1)
    log("" = 0)
    log(0 = "")
    log(10 < 9)
    log("10" < "9")

    # Arithmetic.
    log(1 + 2)
    log("3" + "4")
    log(1.5 * 2)
    log(0.1 + 0.2)
    log(10 / 4)
    log(7 % 3)
    log(-7 % 3)
    log(1e21 + 1)
    log(round(2.5))

    # List indexes given as numbers and as text.
    words.clear()
    words.add("a")
    words.add("b")
    words.add("c")
    log(words["1"])
    log(words["1.0"])
    log(words[1.0])
    log(words[2])
    log(words["last"])
    log(words[" 3"])
    words.insert("2", "X")
    log(words.index_of("X"))
    log(words.index_of(2))
    digits.clear()
    digits.add(1)
    digits.add(2)
    log(digits.contains(1))
    log(digits.contains("1.0"))
    log(digits.index_of("2"))

    # Procedure arguments.
    report(1)
    report("1")
    report(1.0)
    report(" 1")
    twice(21)
    twice("21")

    # A costume named "2" is picked by name when the literal is text; costume 2 is "beta".
    switch_costume("alpha")
    switch_costume("2")
    log(costume_name())
    log(costume_number())
    # A literal that equals a costume name stays text when it is stored (TurboWarp's
    # preserveStrings), so it still picks the costume by name later.
    words.clear()
    words.add(2)
    switch_costume("alpha")
    switch_costume(words[1])
    log(join("item ", costume_name()))
    switch_costume("alpha")
    pick(2)
    log(join("arg ", costume_name()))
    # Other values are numbers or text as computed.
    switch_costume("alpha")
    a = 2
    switch_costume(a)
    log(join("a=2 ", costume_name()))
    switch_costume("alpha")
    a = "2"
    switch_costume(a)
    log(join("a=text2 ", costume_name()))
    switch_costume("alpha")
    a = 3
    switch_costume(a)
    log(join("a=3 ", costume_name()))
    switch_costume("alpha")
    a = 1 + 1
    switch_costume(a)
    log(join("a=1+1 ", costume_name()))
